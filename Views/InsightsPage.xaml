<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HexFund.UI.ViewModels"
             x:Class="HexFund.UI.Views.InsightsPage"
             x:DataType="vm:InsightsViewModel"
             Title="Insights"
             BackgroundColor="{DynamicResource SurfacePage}">
<Grid>
        <Image Source="{Binding CurrentThemeBackdrop}"
               Aspect="AspectFill"
               InputTransparent="True"/>

        <RefreshView Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsLoading}"
                 RefreshColor="{DynamicResource Accent}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- ── No account state ──────────────────────────────────── -->
                <Border IsVisible="{Binding HasAccount, Converter={StaticResource InvertedBoolConverter}}"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{DynamicResource SurfaceCard}"
                        Stroke="{DynamicResource StrokeCard}" StrokeThickness="1"
                        Padding="24">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="📊" FontSize="40" HorizontalOptions="Center"/>
                        <Label Text="No account selected"
                               FontSize="16" FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                        <Label Text="Select an account to see your spending insights."
                               FontSize="13" TextColor="{DynamicResource TextSecondary}"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Error state ────────────────────────────────────────── -->
                <Border IsVisible="{Binding HasError}"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{DynamicResource SurfaceCard}"
                        Stroke="{DynamicResource Down}" StrokeThickness="1"
                        Padding="16">
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{DynamicResource Down}"
                           FontSize="14" HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </Border>

                <!-- All insight sections visible when account is set and not loading -->
                <VerticalStackLayout
                    Spacing="14"
                    IsVisible="{Binding HasAccount}">

                    <!-- Month navigator -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                        <Button Grid.Column="0"
                                Text="◀"
                                Command="{Binding PreviousMonthCommand}"
                                BackgroundColor="{DynamicResource SurfaceHi}"
                                TextColor="{DynamicResource Accent}"
                                BorderColor="{DynamicResource StrokeCard}" BorderWidth="1"
                                CornerRadius="8" WidthRequest="40" HeightRequest="36"
                                FontSize="14" Padding="0"/>
                        <Label Grid.Column="1"
                               Text="{Binding CurrentMonthLabel}"
                               FontSize="16" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{DynamicResource TextPrimary}"/>
                        <Button Grid.Column="2"
                                Text="▶"
                                Command="{Binding NextMonthCommand}"
                                BackgroundColor="{DynamicResource SurfaceHi}"
                                TextColor="{DynamicResource Accent}"
                                BorderColor="{DynamicResource StrokeCard}" BorderWidth="1"
                                CornerRadius="8" WidthRequest="40" HeightRequest="36"
                                FontSize="14" Padding="0" Margin="0,0,0,0"/>
                    </Grid>

                    <!-- ════════════════════════════════════════════════════
                         SECTION 1 — Smart Alerts
                         Shown above the charts so they're seen first.
                         ════════════════════════════════════════════════════ -->
                    <VerticalStackLayout
                        IsVisible="{Binding HasAlerts}"
                        Spacing="8">

                        <Label Text="⚠️ Spend Alerts"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{DynamicResource Warn}"/>

                        <VerticalStackLayout Spacing="8"
                                             BindableLayout.ItemsSource="{Binding SpendAlerts}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpendAlert">
                                    <Border StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{DynamicResource SurfaceCard}"
                                            Stroke="{DynamicResource Warn}"
                                            StrokeThickness="1"
                                            Padding="14,12">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <BoxView Grid.Column="0"
                                                     WidthRequest="4" HeightRequest="36"
                                                     CornerRadius="2"
                                                     Color="{DynamicResource Warn}"
                                                     VerticalOptions="Center"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Message}"
                                                   FontSize="13"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   LineBreakMode="WordWrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- ════════════════════════════════════════════════════
                         SECTION 2 — Category Spending Breakdown
                         ════════════════════════════════════════════════════ -->
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource SurfaceCard}"
                            Stroke="{DynamicResource StrokeCard}" StrokeThickness="1"
                            Padding="16">
                        <VerticalStackLayout Spacing="14">

                            <!-- Header -->
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Spending by Category"
                                           FontSize="15" FontAttributes="Bold"/>
                                    <Label Text="{Binding CurrentMonthLabel}"
                                           FontSize="11"
                                           TextColor="{DynamicResource TextSecondary}"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2"
                                                     HorizontalOptions="End"
                                                     IsVisible="{Binding HasCategoryData}">
                                    <Label Text="Total Expenses"
                                           FontSize="10"
                                           TextColor="{DynamicResource TextSecondary}"
                                           HorizontalOptions="End"/>
                                    <Label Text="{Binding TotalExpensesDisplay}"
                                           FontSize="16" FontAttributes="Bold"
                                           TextColor="{DynamicResource Down}"
                                           HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource SurfaceDivider}"/>

                            <!-- Empty state -->
                            <VerticalStackLayout
                                IsVisible="{Binding HasCategoryData, Converter={StaticResource InvertedBoolConverter}}"
                                Spacing="6" HorizontalOptions="Center" Margin="0,8">
                                <Label Text="Not enough data yet"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextSecondary}"
                                       HorizontalOptions="Center"/>
                                <Label Text="{Binding CategoryEmptyReason}"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextMuted}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>

                            <!-- Category bars -->
                            <VerticalStackLayout
                                IsVisible="{Binding HasCategoryData}"
                                Spacing="10"
                                BindableLayout.ItemsSource="{Binding CategorySlices}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CategorySlice">
                                        <VerticalStackLayout Spacing="5">
                                            <!-- Label row -->
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <HorizontalStackLayout Grid.Column="0" Spacing="8">
                                                    <BoxView WidthRequest="10" HeightRequest="10"
                                                             CornerRadius="5"
                                                             Color="{Binding SliceColor}"
                                                             VerticalOptions="Center"/>
                                                    <Label Text="{Binding Category}"
                                                           FontSize="13"
                                                           TextColor="{DynamicResource TextPrimary}"
                                                           VerticalOptions="Center"
                                                           LineBreakMode="TailTruncation"/>
                                                </HorizontalStackLayout>
                                                <Label Grid.Column="1"
                                                       Text="{Binding TotalDisplay}"
                                                       FontSize="13" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextPrimary}"
                                                       VerticalOptions="Center"/>
                                                <Label Grid.Column="2"
                                                       Text="{Binding PercentageDisplay}"
                                                       FontSize="12"
                                                       TextColor="{DynamicResource TextSecondary}"
                                                       VerticalOptions="Center"
                                                       MinimumWidthRequest="38"/>
                                            </Grid>
                                            <!-- Bar track using ProgressBar — Progress binds directly to 0-1 BarWeight -->
                                            <ProgressBar Progress="{Binding BarWeight}"
                                                         ProgressColor="{Binding SliceColor}"
                                                         BackgroundColor="{DynamicResource SurfaceLo}"
                                                         HeightRequest="8"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                    <!-- ════════════════════════════════════════════════════
                         SECTION 3 — 6-Month Net Change Trend
                         ════════════════════════════════════════════════════ -->
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource SurfaceCard}"
                            Stroke="{DynamicResource StrokeCard}" StrokeThickness="1"
                            Padding="16">
                        <VerticalStackLayout Spacing="14">

                            <Label Text="6-Month Trend"
                                   FontSize="15" FontAttributes="Bold"/>

                            <BoxView HeightRequest="1" Color="{DynamicResource SurfaceDivider}"/>

                            <!-- No trend data -->
                            <Label IsVisible="{Binding HasTrendData, Converter={StaticResource InvertedBoolConverter}}"
                                   Text="No transaction data found for the last 6 months."
                                   FontSize="13" TextColor="{DynamicResource TextMuted}"
                                   HorizontalOptions="Center" Margin="0,8"/>

                            <!-- Bar chart — HorizontalStackLayout+BindableLayout fixes the MAUI bug
                                 where Grid+BindableLayout ignores Grid.Column assignments -->
                            <VerticalStackLayout IsVisible="{Binding HasTrendData}" Spacing="8">

                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center"
                                                       BindableLayout.ItemsSource="{Binding MonthBars}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MonthBar">
                                            <VerticalStackLayout WidthRequest="44" Spacing="3">
                                                <!-- Spacer pushes bar to bottom of the 120px chart area -->
                                                <BoxView Color="Transparent"
                                                         HeightRequest="{Binding SpacerHeightPx}"
                                                         VerticalOptions="Start"/>
                                                <!-- Bar -->
                                                <Border StrokeShape="RoundRectangle 4" StrokeThickness="0"
                                                        BackgroundColor="{Binding BarColor}"
                                                        HeightRequest="{Binding BarHeightPx}"
                                                        VerticalOptions="End"/>
                                                <!-- Month label -->
                                                <Label Text="{Binding MonthLabel}" FontSize="10"
                                                       TextColor="{DynamicResource TextSecondary}"
                                                       HorizontalOptions="Center"/>
                                                <!-- Value label -->
                                                <Label Text="{Binding ValueDisplay}" FontSize="9"
                                                       HorizontalOptions="Center"
                                                       HorizontalTextAlignment="Center"
                                                       TextColor="{DynamicResource TextMuted}"
                                                       LineBreakMode="TailTruncation"/>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>

                                <!-- Legend -->
                                <HorizontalStackLayout Spacing="16"
                                                       HorizontalOptions="Center"
                                                       Margin="0,6,0,0">
                                    <HorizontalStackLayout Spacing="6">
                                        <BoxView WidthRequest="10" HeightRequest="10"
                                                 CornerRadius="2"
                                                 Color="{DynamicResource Up}"
                                                 VerticalOptions="Center"/>
                                        <Label Text="Positive" FontSize="11"
                                               TextColor="{DynamicResource TextSecondary}"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="6">
                                        <BoxView WidthRequest="10" HeightRequest="10"
                                                 CornerRadius="2"
                                                 Color="{DynamicResource Down}"
                                                 VerticalOptions="Center"/>
                                        <Label Text="Negative" FontSize="11"
                                               TextColor="{DynamicResource TextSecondary}"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <BoxView HeightRequest="20" Color="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

    </Grid>

</ContentPage>
