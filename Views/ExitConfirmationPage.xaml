<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HexFund.UI.Views.ExitConfirmationPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#80000000">

    <!--
        Transparent modal page — the #80000000 background creates the
        dim-overlay effect while the inner Border card is fully themed.
        Matches the Edit/Amend dialog visual language exactly.
    -->
    <Grid>
        <!-- Backdrop tap dismisses -->
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackdropTapped"/>
        </Grid.GestureRecognizers>

        <Border HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{DynamicResource SurfaceCard}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0"
                Padding="28,24"
                WidthRequest="300">
            <!-- Swallow taps so they don't reach the backdrop dismiss -->
            <Border.GestureRecognizers>
                <TapGestureRecognizer/>
            </Border.GestureRecognizers>

            <VerticalStackLayout Spacing="16">

                <Label Text="Exit HexFund?"
                       FontSize="20" FontAttributes="Bold"
                       HorizontalOptions="Center"/>

                <Label Text="Are you sure you want to close the app?"
                       FontSize="14"
                       TextColor="{DynamicResource TextSecondary}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                    <Button Grid.Column="0"
                            Text="Cancel"
                            Clicked="OnCancelClicked"
                            BackgroundColor="{DynamicResource SurfaceHi}"
                            TextColor="{DynamicResource TextSecondary}"
                            CornerRadius="10" Padding="0,12"/>
                    <Button Grid.Column="1"
                            Text="Exit"
                            Clicked="OnExitClicked"
                            BackgroundColor="{DynamicResource Down}"
                            TextColor="White"
                            CornerRadius="10" Padding="0,12"/>
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
