<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HexFund.UI.ViewModels"
             xmlns:models="clr-namespace:HexFund.UI.Models"
             x:Class="HexFund.UI.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             BackgroundColor="{DynamicResource SurfacePage}">

    <!-- ── Custom header — matches the prototype: logo · wordmark · subtitle · gear ── -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*,Auto"
              Padding="4,0"
              ColumnSpacing="10">

            <!-- Hex logo mark -->
            <Border Grid.Column="0"
                    WidthRequest="34" HeightRequest="34"
                    StrokeShape="Ellipse"
                    BackgroundColor="{DynamicResource AccentGlow}"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                <Image Source="{Binding CurrentThemeLogo}"
                       WidthRequest="28" HeightRequest="28"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <!-- Wordmark + theme subtitle -->
            <VerticalStackLayout Grid.Column="1"
                                 Spacing="0"
                                 VerticalOptions="Center">
                <Label Text="HexFund"
                       FontFamily="CinzelBold"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       LineBreakMode="NoWrap"/>
                <Label Text="{Binding SelectedAccountName}"
                       FontSize="9"
                       CharacterSpacing="2"
                       TextColor="{DynamicResource Accent}"
                       LineBreakMode="NoWrap"/>
            </VerticalStackLayout>

            <!-- Settings gear -->
            <Border Grid.Column="2"
                    WidthRequest="32" HeightRequest="32"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{DynamicResource SurfaceLo}"
                    Stroke="{DynamicResource StrokeCard}"
                    StrokeThickness="1"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToSettingsCommand}"/>
                </Border.GestureRecognizers>
                <Image Source="settings.png"
                       WidthRequest="16" HeightRequest="16"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

        </Grid>
    </Shell.TitleView>

    <!-- Full-bleed vault backdrop sits behind all content -->
    <Grid>
        <Image Source="{Binding CurrentThemeBackdrop}"
               Aspect="AspectFill"
               IsAnimationPlaying="False"
               InputTransparent="True"/>

        <RefreshView Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsLoading}"
                     RefreshColor="{DynamicResource Accent}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="14">

                <!-- ════════════════════════════════════════════════════════
                     LOADING SKELETON — visible while IsLoading=true
                     ════════════════════════════════════════════════════════ -->
                <VerticalStackLayout IsVisible="{Binding IsLoading}" Spacing="14">

                    <!-- Skeleton: BalanceHero -->
                    <Border StrokeShape="RoundRectangle 16"
                            BackgroundColor="{DynamicResource SurfaceHi}"
                            Stroke="{DynamicResource StrokeCard}"
                            StrokeThickness="1"
                            Padding="20" MinimumHeightRequest="120">
                        <VerticalStackLayout Spacing="12">
                            <BoxView HeightRequest="11" WidthRequest="100" CornerRadius="5"
                                     Color="{DynamicResource StrokeHi}" HorizontalOptions="Start"/>
                            <BoxView HeightRequest="34" WidthRequest="190" CornerRadius="6"
                                     Color="{DynamicResource StrokeHi}" HorizontalOptions="Start"/>
                            <BoxView HeightRequest="10" WidthRequest="120" CornerRadius="5"
                                     Color="{DynamicResource StrokeHi}" HorizontalOptions="Start"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Skeleton: Quick actions -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource SurfaceCard}"
                                Stroke="{DynamicResource StrokeCard}" StrokeThickness="1"
                                MinimumHeightRequest="76"/>
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource SurfaceCard}"
                                Stroke="{DynamicResource StrokeCard}" StrokeThickness="1"
                                MinimumHeightRequest="76"/>
                        <Border Grid.Column="2" StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource SurfaceCard}"
                                Stroke="{DynamicResource StrokeCard}" StrokeThickness="1"
                                MinimumHeightRequest="76"/>
                    </Grid>

                    <!-- Skeleton: Accounts preview -->
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource SurfaceCard}"
                            Stroke="{DynamicResource StrokeCard}" StrokeThickness="1"
                            Padding="16">
                        <VerticalStackLayout Spacing="14">
                            <BoxView HeightRequest="11" WidthRequest="80" CornerRadius="5"
                                     Color="{DynamicResource StrokeHi}" HorizontalOptions="Start"/>
                            <BoxView HeightRequest="1" Color="{DynamicResource SurfaceDivider}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <BoxView Grid.Column="0" HeightRequest="11" WidthRequest="140" CornerRadius="5" Color="{DynamicResource StrokeHi}" VerticalOptions="Center"/>
                                <BoxView Grid.Column="1" HeightRequest="11" WidthRequest="70"  CornerRadius="5" Color="{DynamicResource StrokeHi}" VerticalOptions="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <BoxView Grid.Column="0" HeightRequest="11" WidthRequest="110" CornerRadius="5" Color="{DynamicResource StrokeHi}" VerticalOptions="Center"/>
                                <BoxView Grid.Column="1" HeightRequest="11" WidthRequest="70"  CornerRadius="5" Color="{DynamicResource StrokeHi}" VerticalOptions="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <BoxView Grid.Column="0" HeightRequest="11" WidthRequest="130" CornerRadius="5" Color="{DynamicResource StrokeHi}" VerticalOptions="Center"/>
                                <BoxView Grid.Column="1" HeightRequest="11" WidthRequest="70"  CornerRadius="5" Color="{DynamicResource StrokeHi}" VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Skeleton: Recent activity -->
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource SurfaceCard}"
                            Stroke="{DynamicResource StrokeCard}" StrokeThickness="1"
                            Padding="16">
                        <VerticalStackLayout Spacing="14">
                            <BoxView HeightRequest="11" WidthRequest="110" CornerRadius="5"
                                     Color="{DynamicResource StrokeHi}" HorizontalOptions="Start"/>
                            <BoxView HeightRequest="1" Color="{DynamicResource SurfaceDivider}"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <BoxView Grid.Column="0" WidthRequest="4" HeightRequest="36" CornerRadius="2" Color="{DynamicResource StrokeHi}"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <BoxView HeightRequest="11" WidthRequest="130" CornerRadius="5" Color="{DynamicResource StrokeHi}"/>
                                    <BoxView HeightRequest="9"  WidthRequest="80"  CornerRadius="4" Color="{DynamicResource StrokeHi}"/>
                                </VerticalStackLayout>
                                <BoxView Grid.Column="2" HeightRequest="11" WidthRequest="60" CornerRadius="5" Color="{DynamicResource StrokeHi}" VerticalOptions="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <BoxView Grid.Column="0" WidthRequest="4" HeightRequest="36" CornerRadius="2" Color="{DynamicResource StrokeHi}"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <BoxView HeightRequest="11" WidthRequest="150" CornerRadius="5" Color="{DynamicResource StrokeHi}"/>
                                    <BoxView HeightRequest="9"  WidthRequest="90"  CornerRadius="4" Color="{DynamicResource StrokeHi}"/>
                                </VerticalStackLayout>
                                <BoxView Grid.Column="2" HeightRequest="11" WidthRequest="60" CornerRadius="5" Color="{DynamicResource StrokeHi}" VerticalOptions="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <BoxView Grid.Column="0" WidthRequest="4" HeightRequest="36" CornerRadius="2" Color="{DynamicResource StrokeHi}"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <BoxView HeightRequest="11" WidthRequest="120" CornerRadius="5" Color="{DynamicResource StrokeHi}"/>
                                    <BoxView HeightRequest="9"  WidthRequest="70"  CornerRadius="4" Color="{DynamicResource StrokeHi}"/>
                                </VerticalStackLayout>
                                <BoxView Grid.Column="2" HeightRequest="11" WidthRequest="60" CornerRadius="5" Color="{DynamicResource StrokeHi}" VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
                <!-- END SKELETON -->

                <!-- ════════════════════════════════════════════════════════
                     REAL CONTENT — visible when IsLoading=false
                     ════════════════════════════════════════════════════════ -->
                <VerticalStackLayout IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                                     Spacing="14">

                    <!-- ── Error state ───────────────────────────────────── -->
                    <Border IsVisible="{Binding HasError}"
                            BackgroundColor="{DynamicResource SurfaceCard}"
                            Stroke="{DynamicResource Down}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="16">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{DynamicResource Down}"
                               FontSize="14"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                    </Border>

                    <!-- ── BalanceHero card ───────────────────────────────── -->
                    <Border StrokeShape="RoundRectangle 16"
                            BackgroundColor="{DynamicResource SurfaceHi}"
                            Stroke="{DynamicResource AccentGlow}"
                            StrokeThickness="1"
                            Padding="20">
                        <Border.Shadow>
                            <Shadow Brush="{DynamicResource AccentGlow}"
                                    Opacity="0.6" Radius="20" Offset="0,4"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Account Balance"
                                   FontSize="10"
                                   CharacterSpacing="3"
                                   TextTransform="Uppercase"
                                   TextColor="{DynamicResource Accent}"/>
                            <Label Text="{Binding TotalBalanceDisplay}"
                                   FontSize="36"
                                   FontAttributes="Bold"
                                   FontFamily="CinzelBold"
                                   TextColor="{DynamicResource AccentInk}"/>
                            <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                                <Label Text="{Binding MonthNetChangeArrow}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{Binding MonthNetChangeColor}"
                                       VerticalOptions="Center"/>
                                <Label Text="{Binding MonthNetChangeDisplay}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{Binding MonthNetChangeColor}"
                                       VerticalOptions="Center"/>
                                <Label Text="this month"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ── Accounts preview ───────────────────────────────── -->
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource SurfaceCard}"
                            Stroke="{DynamicResource StrokeCard}"
                            StrokeThickness="1"
                            Padding="16">
                        <VerticalStackLayout Spacing="12">

                            <!-- Section header -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Accounts"
                                       FontSize="15" FontAttributes="Bold"/>
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="Transparent"
                                        Stroke="{DynamicResource StrokeCard}"
                                        StrokeThickness="1"
                                        Padding="10,4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToAccountsCommand}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="View all →"
                                           FontSize="12"
                                           TextColor="{DynamicResource Accent}"/>
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource SurfaceDivider}"/>

                            <!-- Account rows -->
                            <VerticalStackLayout Spacing="0"
                                                 BindableLayout.ItemsSource="{Binding PreviewAccounts}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Account">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                              ColumnSpacing="12"
                                              Padding="0,10">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=SelectAccountCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            </Grid.GestureRecognizers>
                                            <BoxView Grid.Column="0"
                                                     WidthRequest="3" HeightRequest="32"
                                                     CornerRadius="2"
                                                     Color="{DynamicResource Accent}"
                                                     VerticalOptions="Center"/>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding AccountName}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding IsActive, Converter={StaticResource BoolToTextConverter}}"
                                                       FontSize="11"
                                                       TextColor="{DynamicResource TextMuted}"/>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2"
                                                   Text="{Binding CurrentBalance, StringFormat='{0:C}'}"
                                                   FontSize="15" FontAttributes="Bold"
                                                   TextColor="{DynamicResource AccentInk}"
                                                   VerticalOptions="Center"/>
                                            <!-- Active account indicator dot -->
                                            <Ellipse Grid.Column="3"
                                                     WidthRequest="8" HeightRequest="8"
                                                     VerticalOptions="Center"
                                                     Fill="{DynamicResource Accent}">
                                                <Ellipse.IsVisible>
                                                    <MultiBinding Converter="{StaticResource AccountIsSelectedConverter}">
                                                        <Binding Path="AccountId"/>
                                                        <Binding Source="{RelativeSource AncestorType={x:Type vm:HomeViewModel}}" Path="SelectedAccountId"/>
                                                    </MultiBinding>
                                                </Ellipse.IsVisible>
                                            </Ellipse>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Empty state -->
                            <Label IsVisible="{Binding HasAccounts, Converter={StaticResource InvertedBoolConverter}}"
                                   Text="No accounts yet — tap the hex button to get started."
                                   FontSize="13"
                                   TextColor="{DynamicResource TextMuted}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,8"/>

                        </VerticalStackLayout>
                    </Border>

                    <!-- ── Recent activity (collapsible) ─────────────────── -->
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource SurfaceCard}"
                            Stroke="{DynamicResource StrokeCard}"
                            StrokeThickness="1" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Recent Activity"
                                       FontSize="15" FontAttributes="Bold"/>
                                <Border Grid.Column="1" StrokeShape="RoundRectangle 8"
                                        BackgroundColor="Transparent"
                                        Stroke="{DynamicResource StrokeCard}" StrokeThickness="1"
                                        Padding="10,4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleRecentSectionCommand}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding IsRecentExpanded,
                                           Converter={StaticResource BoolToStringConverter},
                                           ConverterParameter='▲ Collapse|▼ Expand'}"
                                           FontSize="12" TextColor="{DynamicResource Accent}"/>
                                </Border>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource SurfaceDivider}"/>
                            <VerticalStackLayout IsVisible="{Binding IsRecentExpanded}" Spacing="0"
                                                 BindableLayout.ItemsSource="{Binding RecentTransactions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RecentTransaction">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,10">
                                            <BoxView Grid.Column="0" WidthRequest="4" HeightRequest="36"
                                                     CornerRadius="2" Color="{Binding AccentColor}"
                                                     VerticalOptions="Center"/>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding Description}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"/>
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{Binding AccountName}" FontSize="11"
                                                           TextColor="{DynamicResource TextMuted}"
                                                           LineBreakMode="TailTruncation"/>
                                                    <Label Text="·" FontSize="11" TextColor="{DynamicResource TextMuted}"/>
                                                    <Label Text="{Binding DateDisplay}" FontSize="11"
                                                           TextColor="{DynamicResource TextMuted}"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding AmountDisplay}"
                                                   FontSize="15" FontAttributes="Bold"
                                                   TextColor="{Binding AmountColor}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label IsVisible="{Binding HasRecentTransactions, Converter={StaticResource InvertedBoolConverter}}"
                                   Text="No recent activity"
                                   FontSize="13" TextColor="{DynamicResource TextMuted}"
                                   HorizontalOptions="Center" Margin="0,8"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ── Upcoming transactions (collapsible) ───────────── -->
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource SurfaceCard}"
                            Stroke="{DynamicResource StrokeCard}"
                            StrokeThickness="1" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Upcoming Transactions"
                                       FontSize="15" FontAttributes="Bold"/>
                                <Border Grid.Column="1" StrokeShape="RoundRectangle 8"
                                        BackgroundColor="Transparent"
                                        Stroke="{DynamicResource StrokeCard}" StrokeThickness="1"
                                        Padding="10,4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleUpcomingSectionCommand}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding IsUpcomingExpanded,
                                           Converter={StaticResource BoolToStringConverter},
                                           ConverterParameter='▲ Collapse|▼ Expand'}"
                                           FontSize="12" TextColor="{DynamicResource Accent}"/>
                                </Border>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource SurfaceDivider}"/>
                            <VerticalStackLayout IsVisible="{Binding IsUpcomingExpanded}" Spacing="0"
                                                 BindableLayout.ItemsSource="{Binding UpcomingTransactions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RecentTransaction">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,10">
                                            <BoxView Grid.Column="0" WidthRequest="4" HeightRequest="36"
                                                     CornerRadius="2" Color="{Binding AccentColor}"
                                                     VerticalOptions="Center"/>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding Description}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"/>
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{Binding AccountName}" FontSize="11"
                                                           TextColor="{DynamicResource TextMuted}"
                                                           LineBreakMode="TailTruncation"/>
                                                    <Label Text="·" FontSize="11" TextColor="{DynamicResource TextMuted}"/>
                                                    <Label Text="{Binding DateDisplay}" FontSize="11"
                                                           TextColor="{DynamicResource TextMuted}"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding AmountDisplay}"
                                                   FontSize="15" FontAttributes="Bold"
                                                   TextColor="{Binding AmountColor}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label IsVisible="{Binding HasUpcomingTransactions, Converter={StaticResource InvertedBoolConverter}}"
                                   Text="No upcoming transactions in the next two months"
                                   FontSize="13" TextColor="{DynamicResource TextMuted}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                   Margin="0,8"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
                <!-- END REAL CONTENT -->

                <BoxView HeightRequest="20" Color="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

    <!-- ── Onboarding overlay ────────────────────────────────────────────────
         Shown once to first-time users until dismissed or both steps complete.
         Sits above all content as a bottom sheet anchored inside the page Grid.
    ──────────────────────────────────────────────────────────────────────── -->
    <Grid IsVisible="{Binding ShowOnboarding}"
          VerticalOptions="End"
          Margin="0,0,0,90">

        <!-- Scrim — taps outside the card do nothing (card handles all actions) -->
        <Border BackgroundColor="#99000000"
                StrokeThickness="0"
                IsVisible="False"/>

        <Border Margin="16,0"
                BackgroundColor="{DynamicResource SurfaceCard}"
                Stroke="{DynamicResource Accent}"
                StrokeThickness="1.5"
                StrokeShape="RoundRectangle 20"
                Padding="24,20">
            <Border.Shadow>
                <Shadow Brush="{DynamicResource AccentGlow}"
                        Opacity="0.5" Radius="24" Offset="0,4"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="16">

                <!-- Header row: step indicator + dismiss -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Grid.Column="0"
                            BackgroundColor="{DynamicResource Accent}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 6"
                            Padding="8,3"
                            VerticalOptions="Center">
                        <Label Text="{Binding OnboardingStep, StringFormat='Step {0} of 2'}"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{DynamicResource SurfacePage}"/>
                    </Border>
                    <Label Grid.Column="1"
                           Text="Getting Started"
                           FontSize="15" FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           VerticalOptions="Center"/>
                    <Border Grid.Column="2"
                            BackgroundColor="Transparent"
                            Stroke="{DynamicResource StrokeCard}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="8,4"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DismissOnboardingCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="Skip all" FontSize="11"
                               TextColor="{DynamicResource TextSecondary}"/>
                    </Border>
                </Grid>

                <BoxView HeightRequest="1" Color="{DynamicResource SurfaceDivider}"/>

                <!-- Step 1: Create Account -->
                <VerticalStackLayout Spacing="10"
                                     IsVisible="{Binding IsOnboardingStep1}">
                    <Label Text="Create your first account"
                           FontSize="17" FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"/>
                    <Label Text="An account tracks a real wallet, bank account, or savings pot. Your balance and projections are built around it."
                           FontSize="13"
                           TextColor="{DynamicResource TextSecondary}"
                           LineBreakMode="WordWrap"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                        <Border Grid.Column="0"
                                BackgroundColor="{DynamicResource Accent}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnboardingGoToAccountsCommand}"/>
                            </Border.GestureRecognizers>
                            <Label Text="Create Account →"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{DynamicResource SurfacePage}"
                                   HorizontalOptions="Center"
                                   Padding="0,12"/>
                        </Border>
                        <Border Grid.Column="1"
                                BackgroundColor="Transparent"
                                Stroke="{DynamicResource StrokeCard}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DismissOnboardingCommand}"/>
                            </Border.GestureRecognizers>
                            <Label Text="Skip" FontSize="14"
                                   TextColor="{DynamicResource TextSecondary}"
                                   HorizontalOptions="Center"
                                   Padding="20,12"/>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Step 2: Add Transaction -->
                <VerticalStackLayout Spacing="10"
                                     IsVisible="{Binding IsOnboardingStep2}">
                    <Label Text="Add your first transaction"
                           FontSize="17" FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"/>
                    <Label Text="Tap the hex button or use the shortcut below to record income or an expense. Set a frequency to track recurring payments automatically."
                           FontSize="13"
                           TextColor="{DynamicResource TextSecondary}"
                           LineBreakMode="WordWrap"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                        <Border Grid.Column="0"
                                BackgroundColor="{DynamicResource Accent}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnboardingGoToAddCommand}"/>
                            </Border.GestureRecognizers>
                            <Label Text="Add Transaction →"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{DynamicResource SurfacePage}"
                                   HorizontalOptions="Center"
                                   Padding="0,12"/>
                        </Border>
                        <Border Grid.Column="1"
                                BackgroundColor="Transparent"
                                Stroke="{DynamicResource StrokeCard}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DismissOnboardingCommand}"/>
                            </Border.GestureRecognizers>
                            <Label Text="Skip" FontSize="14"
                                   TextColor="{DynamicResource TextSecondary}"
                                   HorizontalOptions="Center"
                                   Padding="20,12"/>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>
    </Grid>

    </Grid>

</ContentPage>
