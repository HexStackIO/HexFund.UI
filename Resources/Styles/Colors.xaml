<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Static fallbacks, used by Styles.xaml and before the first theme is applied. The accent and
        semantic tokens are injected at runtime by ThemeService.Apply, so page XAML must reference
        those with DynamicResource. Use StaticResource only for the constants in this file.
    -->

    <!--
        Same values as the static fields in ThemeService, so Styles.xaml can use them for
        structural elements that never change per theme.
    -->
    <Color x:Key="VaultBg">#0A0B0D</Color>
    <Color x:Key="VaultBgDeep">#050506</Color>
    <Color x:Key="VaultSurface">#141619</Color>
    <Color x:Key="VaultSurfaceHi">#1C1F23</Color>
    <Color x:Key="VaultSurfaceLo">#0F1114</Color>
    <Color x:Key="VaultStroke">#26292F</Color>
    <Color x:Key="VaultStrokeHi">#383C45</Color>
    <Color x:Key="VaultDivider">#1F2126</Color>
    <Color x:Key="VaultText">#EDEEF0</Color>
    <Color x:Key="VaultTextDim">#8B8F98</Color>
    <Color x:Key="VaultTextMute">#5A5E68</Color>

    <!--
        Static fallbacks. ThemeService.Apply also injects Up, Down and Warn, which page XAML should
        prefer.
    -->
    <Color x:Key="SemanticUp">#3FB97A</Color>
    <Color x:Key="SemanticDown">#E05A6F</Color>
    <Color x:Key="SemanticWarn">#E0A03F</Color>

    <!--
        Gray100 stays light on purpose: it gives skeleton loaders contrast against the dark
        surfaces.
    -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray700">#2D2D2D</Color>
    <Color x:Key="Gray800">#1A1A1A</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!--
        Used by AppConstants.FallbackPrimary and anywhere the accent is needed before the first
        ThemeService.Apply.
    -->
    <Color x:Key="GoldAccent">#D4AF37</Color>
    <Color x:Key="GoldAccentInk">#FFE8A3</Color>

</ResourceDictionary>
