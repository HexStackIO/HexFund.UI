<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        All colors use DynamicResource against the tokens injected by ThemeService.Apply, which
        documents them. The OS light and dark mode is irrelevant because the surfaces are always
        dark.
    -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfacePage}" />
    </Style>

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfacePage}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular"/>
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="InterRegular"/>
        <Setter Property="TextColor"        Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="BackgroundColor"  Value="{DynamicResource SurfaceLo}" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="InterRegular"/>
        <Setter Property="TextColor"        Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="BackgroundColor"  Value="{DynamicResource SurfaceLo}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold"/>
        <Setter Property="TextColor"    Value="{DynamicResource TextPrimary}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.75" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="InterRegular"/>
        <Setter Property="TextColor"        Value="{DynamicResource TextPrimary}" />
        <Setter Property="TitleColor"       Value="{DynamicResource TextMuted}" />
        <Setter Property="BackgroundColor"  Value="{DynamicResource SurfaceLo}" />
    </Style>

    <Style TargetType="ScrollView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- Frame is legacy: prefer Border. -->
    <Style TargetType="Frame">
        <Setter Property="BackgroundColor"  Value="{DynamicResource SurfaceCard}" />
        <Setter Property="BorderColor"      Value="{DynamicResource StrokeCard}" />
        <Setter Property="CornerRadius"     Value="12" />
        <Setter Property="HasShadow"        Value="False" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke"          Value="Transparent" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource Accent}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{DynamicResource Accent}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource Accent}" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource Accent}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource StrokeCard}" />
        <Setter Property="ThumbColor"        Value="{DynamicResource AccentInk}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor"   Value="{DynamicResource Accent}" />
        <Setter Property="ThumbColor" Value="{DynamicResource AccentInk}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="FontFamily" Value="InterRegular"/>
        <Setter Property="TextColor"           Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor"    Value="{DynamicResource TextMuted}" />
        <Setter Property="BackgroundColor"     Value="{DynamicResource SurfaceLo}" />
        <Setter Property="CancelButtonColor"   Value="{DynamicResource TextSecondary}" />
    </Style>

</ResourceDictionary>
