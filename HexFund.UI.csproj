<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android36.0;net9.0-ios</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>HexFund.UI</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>HexFund</ApplicationTitle>

		<ApplicationId>com.hexstackio.hexfund</ApplicationId>

		<!-- The release workflow overwrites both version values from the run number. -->
		<ApplicationDisplayVersion>1.5</ApplicationDisplayVersion>
		<ApplicationVersion>5</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
		<Platforms>AnyCPU</Platforms>
	</PropertyGroup>

	<!-- Release only: trimming breaks hot reload and AOT compilation slows debug cycles. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<!-- Partial trimming removes unused code from trim-safe libraries and leaves the
		     reflection-heavy MAUI internals alone. Full trimming breaks XAML bindings and
		     converters at runtime. -->
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>partial</TrimMode>

		<!-- Profiled AOT compiles only the startup path recorded from a real run, which speeds up
		     startup without compiling rarely used code. -->
		<AndroidEnableProfiledAot Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</AndroidEnableProfiledAot>

		<!-- The concurrent collector shortens GC pauses. -->
		<AndroidEnableSGenConcurrent Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</AndroidEnableSGenConcurrent>

		<!-- Mono AOT with LLVM pre-compiles IL to native ARM code at build time. -->
		<MtouchUseLlvm Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">true</MtouchUseLlvm>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg"
		          ForegroundFile="Resources\AppIcon\appiconfg.svg"
		          Color="#0A0B0D" />

		<MauiSplashScreen Include="Resources\Splash\splash.svg"
		                  Color="#0A0B0D"
		                  BaseSize="128,128" />

		<MauiImage Include="Resources\Images\*" />
		<MauiImage Include="Resources\Images\hex_icons\*.svg" />
		<MauiImage Include="Resources\Images\themes\*.svg" />

		<MauiFont Include="Resources\Fonts\*" />

		<!-- LogicalName drops the "Resources\Raw" prefix from the packaged asset path. -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiAsset Include="Resources\changelog.json" LogicalName="changelog.json"/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.82.1" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.10" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.0" />
		<PackageReference Include="CommunityToolkit.Maui" Version="9.1.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
		<PackageReference Include="System.Text.Json" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="Views\SettingsPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

</Project>
